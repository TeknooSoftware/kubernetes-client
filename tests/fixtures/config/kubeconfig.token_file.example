apiVersion: v1
clusters:
- cluster:
    insecure-skip-tls-verify: true
    server: https://your-k8s-cluster.com
  name: cluster-name
contexts:
- context:
    cluster: cluster-name
    user: cluster-user
  name: context-name
current-context: context-name
kind: Config
users:
- name: cluster-user
  user:
    tokenFile: token.txt
